# CodeAtlas environment template.
# Copy to .env and adjust:  PowerShell:  Copy-Item .env.example .env
#                           macOS/Linux: cp .env.example .env
#
# NEVER commit the real .env file — it is gitignored.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Default matches the `db` service in docker-compose.yml.
# Change this if you run PostgreSQL outside Docker; the backend also starts
# without a reachable database until DB-backed endpoints arrive.
DATABASE_URL=postgresql+psycopg://codeatlas:codeatlas@localhost:5432/codeatlas

# --- Auth & sessions ---
SESSION_COOKIE_NAME=codeatlas_session
# 7 days in minutes
SESSION_LIFETIME_MINUTES=10080
# Comma-separated origins of the frontend (credentialed CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI providers (NOT required yet) ---
# Leave empty until the AI gateway milestone. Core functionality must work
# without external AI (docs/PRD.md NFR-002). Paste your keys here only when
# asked to.
GEMINI_API_KEY=
GROQ_API_KEY=
